# ========== 模型配置 ==========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Agent 主模型（需要支持 Function Calling）
AGENT_MODEL=gpt-3.5-turbo

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8002

# ========== Agent 配置 ==========
# 最大迭代步数（防止死循环）
MAX_AGENT_STEPS=10
# 搜索 API（可选，用于联网搜索工具）
# 如果没有可以留空，搜索工具会返回模拟数据
TAVILY_API_KEY=
