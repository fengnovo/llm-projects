# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8003

# ========== 多模态模型配置 ==========
# 使用 CLIP 模型做图文向量化（本地运行，不需要 API Key）
CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
# 备选：openai/clip-vit-base-patch32（英文效果好）
# 中文推荐：OFA-Sys/chinese-clip-vit-base-patch16

# 文本 Embedding 模型（用于文本标签检索）
TEXT_EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# 设备：auto 自动选择，cpu / cuda
DEVICE=auto

# ========== 向量数据库配置 ==========
# 使用 Qdrant，支持本地模式（不需要单独部署服务）
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=multimodal_content
QDRANT_VECTOR_SIZE=512  # CLIP 的向量维度

# ========== 检索配置 ==========
RETRIEVE_TOP_K=8
# 混合检索权重：文本相似度 vs 图像相似度
TEXT_WEIGHT=0.5
IMAGE_WEIGHT=0.5

# ========== 数据目录 ==========
UPLOAD_DIR=./data/uploads
IMAGE_DIR=./data/images
