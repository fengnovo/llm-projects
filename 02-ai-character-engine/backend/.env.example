# ========== 模型配置 ==========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
# 主对话模型
CHAT_MODEL=gpt-3.5-turbo
# 记忆总结模型（可以用便宜点的模型）
SUMMARY_MODEL=gpt-3.5-turbo

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000

# ========== 数据库配置 ==========
DATABASE_URL=sqlite+aiosqlite:///./data/character.db

# ========== Redis 配置（可选，用于缓存） ==========
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ========== 角色引擎配置 ==========
# 短期记忆窗口（最近 N 轮对话）
SHORT_TERM_MEMORY_WINDOW=20
# 长期记忆触发阈值（每 N 轮对话总结一次）
LONG_TERM_SUMMARY_INTERVAL=10
# 最大 Token 数（粗略估算，给模型留够空间）
MAX_TOTAL_TOKENS=4000
